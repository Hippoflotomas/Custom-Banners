# Auto detect text files and perform LF normalization
* text=auto

# Windows-only files keep CRLF on checkout
*.sln   text eol=crlf
*.ps1   text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf

# Shell scripts must stay LF or sh chokes on them
*.sh    text eol=lf

# Binaries
*.png   binary
*.jpg   binary
*.webp  binary
*.zip   binary
*.dll   binary
*.exe   binary
